{
  // Cloudflare Workers config: serves the built site (dist/) and the /api/prices endpoint.
  // Deploy with `npm run deploy` after `npx wrangler login`.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "luckledger",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-13",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Only /api/* reaches the Worker code; every other path is served straight from the assets.
    "run_worker_first": ["/api/*"]
  },
  // Every five minutes: refresh the Bazaar when due and up to 10 Auction House quotes from Coflnet.
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  // Wrangler creates the namespace on the first deploy.
  "kv_namespaces": [
    {
      "binding": "PRICES"
    }
  ],
  "observability": {
    "enabled": true
  }
}
