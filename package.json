{
  "name": "luckledger",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc -b",
    "deploy": "npm run build && wrangler deploy",
    "cf:dev": "npm run build && wrangler dev --test-scheduled",
